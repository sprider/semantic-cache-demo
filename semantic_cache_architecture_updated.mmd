%% Semantic Cache Architecture (S3 Vectors + Bedrock)
%% Source: semantic_cache_architecture_updated.mmd
%% Exported PNG/SVG: Use https://mermaid.ai/app/dashboard — paste this file, then export as PNG or SVG.
%%{init: {'theme':'default', 'themeVariables': {'primaryColor':'#ff6b6b','primaryTextColor':'#fff','primaryBorderColor':'#7C0000','lineColor':'#F8B229','secondaryColor':'#006100','tertiaryColor':'#fff'}}}%%
graph TB
    subgraph Users
        AppUsers["👥 Application Users"]
    end
    
    subgraph APILayer
        APIGateway["🌐 API Gateway<br/>(HTTP API)"]
    end
    
    subgraph OrchestrationLayer
        CacheOrch["⚡ Cache Orchestrator<br/>(Lambda Function)"]
        Decision{"Similarity<br/>Check<br/>(≥ 0.85?)"}
    end
    
    subgraph CacheLayer
        direction TB
        S3Vectors["💾 Amazon S3 Vectors<br/>(Serverless Vector DB)"]
        VectorIndex["🔍 Vector Index<br/>(Cosine Similarity)"]
        S3Vectors -.->|"Same Service"| VectorIndex
    end
    
    subgraph AI_ML_Layer
        TitanEmbed["🧠 Titan Text Embeddings V2<br/>(amazon.titan-embed-text-v2:0)<br/>1024 dimensions"]
        ClaudeLLM["🤖 Claude Haiku 4.5<br/>(anthropic.claude-haiku-4-5-20251001-v1:0)"]
    end
    
    subgraph Observability
        CloudWatch["📊 CloudWatch Metrics<br/>(Namespace: SemanticCache)"]
    end
    
    %% Flow: 1→2→3→3a→4→4a→Decision. HIT: 5a→6a→7a (response from cache). MISS: 5b→6→7→8→9 (response from LLM). 10=Metrics.
    %% Flow Steps (1–4: request flow)
    AppUsers -->|"1. Query"| APIGateway
    APIGateway -->|"2. Route"| CacheOrch
    CacheOrch -->|"3. Generate Embedding"| TitanEmbed
    TitanEmbed -->|"3a. Embedding<br/>(1024-dim)"| CacheOrch
    CacheOrch -->|"4. Vector Search"| VectorIndex
    VectorIndex -->|"4a. Similarity Score"| Decision
    Decision -->|"5a. Cache HIT<br/>(~10x faster)<br/>Similarity ≥ 0.85"| CacheOrch
    CacheOrch -->|"6a. Cached Response"| APIGateway
    APIGateway -->|"7a. Response<br/>(from cache)"| AppUsers
    
    %% Cache MISS Path (5b → 6 → 7 → 8 → 9)
    Decision -->|"5b. Cache MISS<br/>Similarity < 0.85"| ClaudeLLM
    ClaudeLLM -->|"6. LLM Response"| CacheOrch
    CacheOrch -->|"7. Store in Cache"| S3Vectors
    CacheOrch -->|"8. LLM Response"| APIGateway
    APIGateway -->|"9. Response<br/>(from LLM)"| AppUsers
    
    %% Observability (10)
    CacheOrch -.->|"10. Metrics"| CloudWatch
    
